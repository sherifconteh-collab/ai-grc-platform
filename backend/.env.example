# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ai_grc_platform

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# The web app's refresh token is an HttpOnly cookie. It is SameSite=None
# (with Secure) in production so the API can live on a different domain from
# the web app; set strict or lax when both share a site.
# REFRESH_COOKIE_SAMESITE=strict

# Password Security
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:3000

# Email Configuration (for password reset)
# Using Gmail as example - you can use any SMTP service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_API=100

# Trust Proxy — REQUIRED when deploying behind a load balancer or PaaS edge
# (Railway, Heroku, Nginx, Cloudflare). Every rate limiter keys on req.ip, and
# Express only derives req.ip from X-Forwarded-For when this is set. Leave it
# unset behind a proxy and req.ip becomes the proxy's own address for every
# request, so all clients share a single rate-limit bucket and audit logs
# record the proxy instead of the caller.
#   TRUST_PROXY=true   -> trust one proxy hop (correct for Railway/Heroku)
#   TRUST_PROXY=2      -> trust two hops (e.g. Cloudflare in front of a PaaS)
# Leave unset only when the app is directly internet-facing.
# TRUST_PROXY=true

# Several backend servers behind a load balancer (see docs/SELF_HOSTED_INSTALL.md,
# "Load balancer and disaster recovery"): share rate limits and live
# notifications through Redis, and stop a server that cannot reach it.
# REDIS_URL=redis://redis.internal:6379
# REDIS_REQUIRED=true

# License Key (optional)
# Set LICENSE_KEY to a ControlWeave-issued license key to unlock Pro/Enterprise features.
# Set LICENSE_SECRET to the signing secret provided by ControlWeave (required for key validation).
# If not set, the application runs in Community Edition mode.
# LICENSE_KEY=v1.<base64url-payload>.<hmac-hex>
# LICENSE_SECRET=your-license-signing-secret

# AI / LLM Configuration (BYOK — Bring Your Own Key)
# Configure at least one provider for AI features (gap analysis, policy generation, etc.).
# Users can also configure keys per-organization via Settings > LLM Configuration in the UI.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...
# OLLAMA_BASE_URL=http://localhost:11434

# URLs entered by organization admins (ITSM, Qualys, Splunk, an Ollama base
# URL) must be public https hosts; each connection is checked when it is made.
# Self-hosted deployments that reach them on a private network set this (it
# also allows plain http). Leave unset on multi-tenant deployments.
# CONNECTOR_ALLOW_PRIVATE_HOSTS=true
# Webhook receivers must resolve to public addresses too; self-hosted installs
# delivering to intranet receivers set these.
# WEBHOOK_ALLOW_PRIVATE_HOSTS=true
# WEBHOOK_ALLOW_HTTP=true

# Platform Admin (auto-provisioned on first startup)
# Set these to create a platform admin account automatically.
# Platform admin bootstrap. Created on first boot; later boots only rotate the
# password when PLATFORM_ADMIN_PASSWORD is set. Without a password, finish
# setup through "Forgot password" -- generated passwords are never logged.
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD=your-secure-password-min-12-chars
# PLATFORM_ADMIN_FIRST_NAME=Platform
# PLATFORM_ADMIN_LAST_NAME=Admin
# PLATFORM_ADMIN_ORG=My Organization

# Who may create an account. "open" (default) lets anyone register and create
# an organization, which suits a public service. On a company's own server set
# "invite_only": people join only when the platform admin invites or creates
# them (Settings -> Users and roles). Any other value is treated as invite_only.
# REGISTRATION_MODE=invite_only

# MCP (Model Context Protocol) Server Configuration
# The MCP server connects to the backend API using JWT auth.
# Run "npm run mcp:login" to authenticate before starting the MCP server.
# GRC_API_BASE_URL=http://localhost:3001/api/v1
# MCP_SESSION_FILE=~/.controlweave/mcp-session.json  # ~ is expanded to $HOME
# MCP_RATE_LIMIT=30
# MCP_REQUEST_TIMEOUT_MS=30000
# MCP_MAX_INPUT_LENGTH=10000
# MCP_MAX_RESULT_LIMIT=200
# MCP_ENABLE_AUDIT_LOG=true

# Uploaded files (evidence, policies). Default: backend/uploads.
# UPLOADS_DIR=/var/lib/controlweave/uploads
# Object storage for uploads (multi-server and DR). Setting S3_BUCKET turns it on;
# unset keeps local disk. See docs/SELF_HOSTED_INSTALL.md "File storage".
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=              # MinIO, Cloudflare R2, Backblaze B2
# S3_FORCE_PATH_STYLE=false # true for MinIO
# S3_PREFIX=uploads/
# S3_SSE=AES256             # AES256 | aws:kms | none
# S3_KMS_KEY_ID=
# STORAGE_LOCAL_DURABLE=false  # true when UPLOADS_DIR is on durable, backed-up disk

# Scheduled database backups (pg_dump must be installed). See docs/SELF_HOSTED_INSTALL.md.
# BACKUP_ENABLED=true
# BACKUP_CRON_SCHEDULE=0 2 * * *
# DB_BACKUP_DIR=/var/backups/controlweave
# DB_BACKUP_RETENTION_DAYS=7
